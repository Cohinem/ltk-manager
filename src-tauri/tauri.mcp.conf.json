{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "mcp-bridge",
          "description": "Dev-only automation bridge, opt-in via `pnpm tauri:mcp`",
          "windows": ["main"],
          "permissions": ["mcp-bridge:default"]
        }
      ]
    }
  }
}
